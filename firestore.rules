rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // ── Safe Helper Functions ──
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function userExists() {
      return isAuthenticated() && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }
    
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function hasRole(role) {
      return userExists() && getUserData().get('role', '') == role;
    }
    
    function isSuperAdmin() {
      return hasRole('superadmin') || (isAuthenticated() && request.auth.token.get('email', '') == 'superadmin@vbit.ac.in');
    }

    function isAdmin() {
      return hasRole('admin') || isSuperAdmin();
    }
    
    function isFaculty() {
      return hasRole('faculty');
    }
    
    function isStudent() {
      return hasRole('student');
    }
    
    function isOwner(uid) {
      return isAuthenticated() && request.auth.uid == uid;
    }

    function isExamController() {
      return hasRole('exam_controller') || isSuperAdmin();
    }

    function isSacDirector() {
      return hasRole('sac_director') || isSuperAdmin();
    }

    function isPrincipal() {
      return hasRole('principal') || isSuperAdmin();
    }

    // ── Users Collection ──
    match /users/{userId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if isAdmin();
    }

    // ── Curriculum Registry ──
    match /curriculum_registry/{subjectCode} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ── Schedules ──
    match /schedules/{scheduleId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ── Notifications ──
    match /notifications/{notificationId} {
      allow read, write: if true;
    }

    // ── Faculty Collection ──
    match /faculty/{facultyId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ── Exam Schedules (Exam Controller Managed) ──
    match /exam_schedules/{examId} {
      allow read: if true;
      allow write: if isExamController() || isSuperAdmin();
    }

    // ── Training Overrides ──
    match /training_overrides/{overrideId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ── Substitutions ──
    match /substitutions/{subId} {
      allow read, write: if true;
    }

    // ── Exam Rooms (Exam Controller Managed) ──
    match /exam_rooms/{roomId} {
      allow read: if true;
      allow write: if isExamController() || isSuperAdmin();
    }

    // ── Exam Sessions (Exam Controller Managed) ──
    match /exam_sessions/{sessionId} {
      allow read: if true;
      allow write: if isExamController() || isSuperAdmin();
    }

    // ── Seating Plans (Published Plans: Public Read; Exam Controller Write) ──
    match /seating_plans/{planId} {
      allow read: if true;
      allow write: if isExamController() || isSuperAdmin();
    }

    // ── Club Lead Booking Privileges (SAC Director & Super Admin Managed) ──
    match /club_leads/{leadId} {
      allow read: if true;
      allow write: if isSacDirector() || isSuperAdmin();
    }

    // ── Campus Facilities Registry (Super Admin Managed) ──
    match /facilities/{facilityId} {
      allow read: if true;
      allow write: if isSuperAdmin() || isAdmin();
    }

    // ── Student Clubs & Members Registry (SAC Director & Super Admin Managed) ──
    match /student_clubs/{clubId} {
      allow read: if true;
      allow write: if isSacDirector() || isSuperAdmin();
    }

    match /club_members/{memberId} {
      allow read: if true;
      allow write: if isSacDirector() || isSuperAdmin() || isAdmin();
    }

    match /club_designations/{desigId} {
      allow read: if true;
      allow write: if isSacDirector() || isSuperAdmin();
    }

    match /custom_departments/{deptId} {
      allow read: if true;
      allow write: if isSacDirector() || isSuperAdmin() || isAdmin();
    }

    match /club_categories/{catId} {
      allow read: if true;
      allow write: if isSacDirector() || isSuperAdmin();
    }

    // ── Facility Bookings Collection ──
    match /facility_bookings/{bookingId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if isSacDirector() || isPrincipal() || isSuperAdmin() || isAdmin();
    }

    // ── Development / Fallback Access ──
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
