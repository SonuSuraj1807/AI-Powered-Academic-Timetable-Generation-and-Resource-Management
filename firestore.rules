rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // ── Safe Helper Functions ──
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function userExists() {
      return isAuthenticated() && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }
    
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function hasRole(role) {
      return userExists() && getUserData().get('role', '') == role;
    }
    
    function isSuperAdmin() {
      return hasRole('superadmin') || (isAuthenticated() && request.auth.token.get('email', '') == 'superadmin@vbit.ac.in');
    }

    function isAdmin() {
      return hasRole('admin') || isSuperAdmin();
    }
    
    function isFaculty() {
      return hasRole('faculty');
    }
    
    function isStudent() {
      return hasRole('student');
    }
    
    function isOwner(uid) {
      return isAuthenticated() && request.auth.uid == uid;
    }

    // ── Users Collection ──
    match /users/{userId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if isAdmin();
    }

    // ── Curriculum Registry ──
    match /curriculum_registry/{subjectCode} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    // ── Schedules ──
    match /schedules/{scheduleId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    // ── Notifications ──
    match /notifications/{notificationId} {
      allow read, write: if true;
    }

    // ── Faculty Collection ──
    match /faculty/{facultyId} {
      allow read, write: if true;
    }

    // ── Exam Schedules ──
    match /exam_schedules/{examId} {
      allow read, write: if true;
    }

    // ── Training Overrides ──
    match /training_overrides/{overrideId} {
      allow read, write: if true;
    }

    // ── Substitutions ──
    match /substitutions/{subId} {
      allow read, write: if true;
    }

    // ── Exam Rooms ──
    match /exam_rooms/{roomId} {
      allow read, write: if true;
    }

    // ── Exam Sessions ──
    match /exam_sessions/{sessionId} {
      allow read, write: if true;
    }

    // ── Seating Plans ──
    match /seating_plans/{planId} {
      allow read, write: if true;
    }

    // ── Club Lead Booking Privileges ──
    match /club_leads/{leadId} {
      allow read, write: if true;
    }

    // ── Facilities Collection ──
    match /facilities/{facilityId} {
      allow read, write: if true;
    }

    // ── Student Clubs & Members Registry ──
    match /student_clubs/{clubId} {
      allow read, write: if true;
    }

    match /club_members/{memberId} {
      allow read, write: if true;
    }

    // ── Facility Bookings Collection ──
    match /facility_bookings/{bookingId} {
      allow read, write: if true;
    }

    // ── Development / Testing Mode Fallback Access ──
    // Allows full read/write for all users to prevent permission errors during E2E testing
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
